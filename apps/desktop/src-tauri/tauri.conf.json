{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NimMD",
  "version": "0.1.0",
  "identifier": "io.github.syper-freedm.nimmd",
  "mainBinaryName": "nimmd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "NimMD",
        "width": 960,
        "height": 720,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'none'; img-src nimmd-asset: data:; connect-src ipc:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "devCsp": "default-src 'none'; img-src nimmd-asset: data:; connect-src ipc: http://127.0.0.1:5173 ws://127.0.0.1:5173; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "14.0" },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "contentTypes": ["net.daringfireball.markdown", "io.github.syper-freedm.nimmd.markdown-extended"],
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["toml"],
        "contentTypes": ["public.toml", "io.github.syper-freedm.nimmd.toml"],
        "name": "TOML",
        "mimeType": "application/toml",
        "role": "Viewer"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML",
        "mimeType": "application/yaml",
        "role": "Viewer"
      },
      {
        "ext": ["json"],
        "name": "JSON",
        "mimeType": "application/json",
        "role": "Viewer"
      },
      {
        "ext": ["csv"],
        "name": "CSV",
        "mimeType": "text/csv",
        "role": "Viewer"
      },
      {
        "ext": ["txt"],
        "name": "Текст",
        "mimeType": "text/plain",
        "role": "Viewer"
      }
    ]
  }
}
