{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Окно получает свой документ и может открыть разрешённую внешнюю ссылку в системном приложении.",
  "windows": ["nimmd-window-*"],
  "permissions": [
    "allow-get-launch",
    "allow-get-view",
    "allow-get-editor",
    "allow-highlight",
    "allow-read-editor",
    "allow-save-editor",
    "allow-recover-editor",
    "allow-finish-editor-close",
    "allow-set-document-edited",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-open-external"
  ]
}
