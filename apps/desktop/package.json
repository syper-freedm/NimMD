    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@lezer/markdown": "1.8.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
