PRODUCT_NAME = NimMDQuickLook
PRODUCT_BUNDLE_IDENTIFIER = io.github.syper-freedm.nimmd.quicklook
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 0.1.0
MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 5.0
APPLICATION_EXTENSION_API_ONLY = YES
ALWAYS_SEARCH_USER_PATHS = NO
SKIP_INSTALL = YES
INFOPLIST_FILE = Info.plist
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = NimMDQuickLook.entitlements
ENABLE_USER_SCRIPT_SANDBOXING = NO
NIMMD_VENDOR_DIR = $(SRCROOT)/../../packages/vendor/dist
HEADER_SEARCH_PATHS = "$(NIMMD_FFI_DIR)"
LIBRARY_SEARCH_PATHS = "$(NIMMD_FFI_DIR)"
SWIFT_OBJC_BRIDGING_HEADER = NimMDBridge.h
OTHER_LDFLAGS = -lnimmd_ffi -liconv
