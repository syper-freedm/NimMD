# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Custom ignore rules
# Спеки/заметки агентов локальны; ADR и AGENTS.md коммитим.
docs/**
!docs/adr/
!docs/adr/**
.claude/
.cursor/
.agents/
AGENTS.*
!AGENTS.md
CLAUDE.*
.remember/
.DS_Store
node_modules/
packages/vendor/dist/

# Машинное состояние конвейера AFD (локально)
tasks/*/control/
apps/macos-quicklook/Build/
apps/macos-quicklook/NimMDQuickLook.xcodeproj/
apps/macos-quicklook/QuickLook/Vendor/**
!apps/macos-quicklook/QuickLook/Vendor/.gitkeep
